# Safe placeholders only. Copy to an ignored local env file when a test project exists.
# VITE_ values are client-visible and must contain publishable values only.
VITE_BACKEND_PROVIDER=firebase
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only values. Never prefix these with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
GOOGLE_APPLICATION_CREDENTIALS=
